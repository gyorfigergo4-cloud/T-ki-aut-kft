@echo off
setlocal
title Toki Auto - Asztali ikon
set "TOKI_ICON_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; try { $tokiBase=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'TokiAuto'; $tokiDesktop=Join-Path ([Environment]::GetFolderPath('Desktop')) 'TokiAuto - Jegyzetek.lnk'; if (!(Test-Path -LiteralPath $tokiDesktop -PathType Leaf)) { throw 'Eloszor inditsd el az app eredeti TokiAuto-Inditas.cmd fajljat, hogy letrejojjon az asztali parancsikon.'; } $tokiLink=(New-Object -ComObject WScript.Shell).CreateShortcut($tokiDesktop); $tokiTarget=$tokiLink.TargetPath; if (!$tokiTarget.StartsWith(($tokiBase+[IO.Path]::DirectorySeparatorChar),[StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetFileName($tokiTarget) -ne 'TokiAuto.exe' -or !(Test-Path -LiteralPath $tokiTarget -PathType Leaf)) { throw 'Ez a parancsikon nem a TokiAuto app telepitett peldanyara mutat. Inditsd el az app eredeti TokiAuto-Inditas.cmd fajljat.'; } $tokiSource=Join-Path $env:TOKI_ICON_DIR 'TokiAuto.ico'; if (!(Test-Path -LiteralPath $tokiSource -PathType Leaf)) { throw 'Hianyzik a TokiAuto.ico. A teljes ikoncsomagot csomagold ki egy mappaba.'; } $tokiHash=(Get-FileHash -LiteralPath $tokiSource -Algorithm SHA256).Hash.ToLowerInvariant(); $tokiIcon=Join-Path $tokiBase ('toki-icon-'+$tokiHash.Substring(0,12)+'.ico'); Copy-Item -LiteralPath $tokiSource -Destination $tokiIcon -Force; $tokiLink.IconLocation=$tokiIcon+',0'; $tokiLink.Description='Toki Auto Kft. - jegyzetek es munkalapok'; $tokiLink.Save(); Write-Host 'KESZ! Az asztali parancsikon Toki Autos ikont kapott.' -ForegroundColor Green; } catch { Write-Host ('HIBA: '+$_.Exception.Message) -ForegroundColor Red; exit 1; }"
pause
endlocal
