@echo off
setlocal
title Toki Auto - Jegyzetek
set "TOKI_PACKAGE_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; try { $tokiRoot=$env:TOKI_PACKAGE_DIR; $tokiManifest=Get-Content -LiteralPath (Join-Path $tokiRoot 'downloads/package.json') -Raw | ConvertFrom-Json; $tokiBase=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'TokiAuto'; New-Item -ItemType Directory -Path $tokiBase -Force | Out-Null; $tokiInstall=Join-Path $tokiBase ('app-'+$tokiManifest.sha256.Substring(0,12)); $tokiExe=Join-Path $tokiInstall 'TokiAuto-win32-x64/TokiAuto.exe'; if (!(Test-Path -LiteralPath $tokiExe)) { Write-Host 'A program elokeszitese...'; $tokiStage=Join-Path $tokiBase ('stage-'+[Guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $tokiStage | Out-Null; try { $tokiZip=Join-Path $tokiStage 'package.zip'; $tokiOutput=[IO.File]::Open($tokiZip,[IO.FileMode]::CreateNew); try { foreach ($tokiPart in $tokiManifest.parts) { if ($tokiPart.file -notmatch '^TokiAuto\.part[0-9]{2}$') { throw 'Ervenytelen csomagnev.'; } $tokiPartFile=Join-Path (Join-Path $tokiRoot 'downloads') $tokiPart.file; if ((Get-FileHash -LiteralPath $tokiPartFile -Algorithm SHA256).Hash.ToLowerInvariant() -ne $tokiPart.sha256) { throw 'Hibas vagy hianyzo letoltes. Toltsd le ujra a teljes ZIP-et.'; } $tokiInput=[IO.File]::OpenRead($tokiPartFile); try { $tokiInput.CopyTo($tokiOutput); } finally { $tokiInput.Dispose(); } } } finally { $tokiOutput.Dispose(); } if ((Get-FileHash -LiteralPath $tokiZip -Algorithm SHA256).Hash.ToLowerInvariant() -ne $tokiManifest.sha256) { throw 'A csomag ellenorzese sikertelen.'; } Add-Type -AssemblyName System.IO.Compression.FileSystem; $tokiFiles=Join-Path $tokiStage 'files'; [IO.Compression.ZipFile]::ExtractToDirectory($tokiZip,$tokiFiles); $tokiCheckExe=Join-Path $tokiFiles 'TokiAuto-win32-x64/TokiAuto.exe'; if ((Get-FileHash -LiteralPath $tokiCheckExe -Algorithm SHA256).Hash.ToLowerInvariant() -ne $tokiManifest.exeSha256) { throw 'Hibas alkalmazasfajl.'; } Move-Item -LiteralPath $tokiFiles -Destination $tokiInstall; } finally { if (Test-Path -LiteralPath $tokiStage) { Remove-Item -LiteralPath $tokiStage -Recurse -Force; } } } if ((Get-FileHash -LiteralPath $tokiExe -Algorithm SHA256).Hash.ToLowerInvariant() -ne $tokiManifest.exeSha256) { throw 'Az alkalmazas fajlja serult.'; } try { $tokiDesktop=Join-Path ([Environment]::GetFolderPath('Desktop')) 'TokiAuto - Jegyzetek.lnk'; $tokiLink=(New-Object -ComObject WScript.Shell).CreateShortcut($tokiDesktop); if (!(Test-Path -LiteralPath $tokiDesktop) -or $tokiLink.TargetPath.StartsWith(($tokiBase+[IO.Path]::DirectorySeparatorChar),[StringComparison]::OrdinalIgnoreCase)) { $tokiLink.TargetPath=$tokiExe; $tokiLink.WorkingDirectory=Split-Path -Path $tokiExe -Parent; $tokiLink.Save(); } } catch {} Start-Process -FilePath $tokiExe -WorkingDirectory (Split-Path -Path $tokiExe -Parent); } catch { Write-Host ('HIBA: '+$_.Exception.Message) -ForegroundColor Red; exit 1; }"
if errorlevel 1 pause
endlocal
